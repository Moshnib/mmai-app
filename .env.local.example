# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore — never commit real keys.

# ---- Supabase (from your Supabase project: Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER-ONLY, never expose this in the browser

# ---- Resend (email alerts for the subscribe feature) ----
# Register free at https://resend.com — 3,000 emails/month free tier.
RESEND_API_KEY=

# ---- BLS (optional — raises rate limit from 25/day to 500/day) ----
# Register free at https://api.bls.gov/registrationEngine/
BLS_API_KEY=

# ---- BEA (required for US GDP growth — lib/fetchers/bea.ts) ----
# Register free at https://www.bea.gov/API/signup/index.cfm — name + email, never expires.
BEA_API_KEY=

# ---- EIA (required for Brent Crude, shared across every market — lib/fetchers/eia.ts) ----
# Register free at https://www.eia.gov/opendata/register.php — email only.
EIA_API_KEY=

# ---- Protects /api/refresh from being triggered by random internet traffic ----
# Any random string you choose — Vercel Cron sends this automatically once configured.
# Powers the question box on /dashboard. Without it the box is not
# rendered at all. Answers are grounded in the stored figures only —
# see lib/askContext.ts.
ANTHROPIC_API_KEY=

CRON_SECRET=choose-a-random-string-here

# ---------------------------------------------------------------------
# ADDED 10 September 2026, after a restorability audit found these three
# used by the code and missing from this file. This file is the only
# record of what a rebuild needs -- .env.local itself is gitignored, so
# anything absent here is a key nobody knows to go and get.
# ---------------------------------------------------------------------

# Japan's official statistics portal (e-Stat). Free, requires
# registration at e-stat.go.jp. Japan's inflation and unemployment come
# from here; without it Japan loses two of its five indicators.
ESTAT_APP_ID=

# The address subscriber alerts are sent FROM. Must be on a domain
# verified with Resend -- a vercel.app address cannot be verified, which
# is why alerts do not send yet. Defaults to alerts@<site domain>.
ALERT_FROM_ADDRESS=

# The site's own public address, used for canonical URLs, the sitemap,
# and the "from" domain above. Set this in Vercel when the real domain
# is live; it falls back to the vercel.app address.
NEXT_PUBLIC_SITE_URL=
