# Machine-specific Claude Code settings (local permissions, launch
# config, task locks). Deliberately not shared -- it has been untracked
# and manually excluded from every commit so far; ignoring it removes
# the chance of sweeping it in by accident.
.claude/

# Bulk data dumps produced by the backfill scripts. 2.3 MB of daily bond
# yields that already live in Supabase -- the script regenerates it on
# demand, so the repo does not need to carry it.
bond-history-backfill.csv

# Database backups from scripts/backup-database.ts. Contains subscriber
# email addresses, so it must never reach a public repository.
backups/
